def c (k : ℕ) : ℤ := coefficients[k]?.getD 0
def s (k : ℕ) : ℤ := moments[k]?.getD 0
def u (k : ℕ) : ℤ := vector[k]?.getD 0

def quadratic : ℤ := ∑ i ∈ Finset.range 20, ∑ j ∈ Finset.range 20, u i * s (i+j) * u j

theorem quadratic_exact : quadratic = (-) := by decide

theorem quadratic_negative : quadratic < 0 := by decide

