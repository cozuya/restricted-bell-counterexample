def NewtonEquation (k : ℕ) : Prop :=
  s k = (-1 : ℤ) ^ (k+1) * k * c k -
    ∑ a ∈ (Finset.antidiagonal k).filter (fun a => a.1 ∈ Set.Ioo 0 k),
      (-1 : ℤ) ^ a.1 * c a.1 * s a.2

instance (k : ℕ) : Decidable (NewtonEquation k) := inferInstanceAs (Decidable (_ = _))

theorem newton_antidiagonal : ∀ k : Fin 39, 0 < k.val → NewtonEquation k.val := by
  decide

